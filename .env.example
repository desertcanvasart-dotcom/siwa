# Copy to .env and fill in. .env is gitignored; this example is committed.

# Postgres connection (Railway provides this in production)
DATABASE_PUBLIC_URL=postgresql://user:pass@host:port/db

# Admin login — REQUIRED for /admin to work. Without ADMIN_PASSWORD no
# admin account is created and login is disabled.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_EMAIL=admin@yourdomain.com

# Signs admin session tokens — set to a long random string, e.g. from:
#   openssl rand -hex 32
# If unset, a random per-boot secret is used and admin sessions are
# invalidated on every restart.
JWT_SECRET=

# OpenAI — powers the /chat concierge
OPENAI_API_KEY=sk-proj-xxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Object storage for uploaded media (S3-compatible: Cloudflare R2
# recommended — zero egress fees). All five must be set to enable;
# without them, uploads fall back to base64-in-Postgres (legacy mode).
#
# R2 setup: Cloudflare dashboard → R2 → Create bucket (e.g. solei-media)
#   → Settings → enable Public access (copy the https://pub-….r2.dev URL)
#   → R2 API Tokens → Create token (Object Read & Write for that bucket).
# Endpoint is https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_URL=
# OBJECT_STORAGE_REGION=auto

# After running `npm run migrate:assets`, set true to serve the
# attached_assets library from the bucket instead of the app filesystem.
ATTACHED_ASSETS_FROM_BUCKET=false

# Resend — powers form / enquiry emails
# Get the key at resend.com → API Keys.
# EMAIL_FROM must be on a domain you've verified in Resend.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Soléi <bookings@yourdomain.com>
EMAIL_TO=owner@youremail.com
